# SceneSync AI — Environment Variables
# Copy this file to `.env` for local development, or set these as
# "Secrets" in your Replit workspace for deployment.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Set to "true" to force the app to run entirely on local simulations
# (no live Vertex AI / Imagen calls). Useful for offline demos.
# If left "false" and no GOOGLE_CLOUD_PROJECT is set, MOCK_MODE turns
# on automatically so the app never crashes.
MOCK_MODE=false

# ---------------------------------------------------------------------------
# Google Cloud / Vertex AI
# ---------------------------------------------------------------------------
# Your GCP project ID (required for live Gemini + Imagen 3 generation)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Vertex AI region
GOOGLE_CLOUD_LOCATION=us-central1

# Path to a service account JSON key file (for local dev only — on Cloud
# Run / Agent Engine, use attached IAM service accounts instead).
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Gemini model used for scene breakdown + asset extraction reasoning
GEMINI_MODEL=gemini-2.0-flash-001
GEMINI_REASONING_MODEL=gemini-2.0-flash-001

# Imagen 3 model used for storyboard concept art
IMAGEN_MODEL=imagen-3.0-generate-002

# Optional: Vertex AI Search data store for grounding (format:
# projects/<PROJECT>/locations/global/collections/default_collection/dataStores/<ID>)
VERTEX_SEARCH_DATASTORE_ID=
VERTEX_SEARCH_LOCATION=global

# ---------------------------------------------------------------------------
# Agent Development Kit
# ---------------------------------------------------------------------------
ADK_APP_NAME=scenesync_pipeline
AGENT_ENGINE_RESOURCE_NAME=

# ---------------------------------------------------------------------------
# Generation tuning
# ---------------------------------------------------------------------------
MAX_SCENES_PER_SCRIPT=40
STORYBOARD_ASPECT_RATIO=16:9
STORYBOARD_IMAGES_PER_SCENE=1
MAX_UPLOAD_MB=15

# ---------------------------------------------------------------------------
# CORS (comma-separated origins, or "*" for all)
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS=*
